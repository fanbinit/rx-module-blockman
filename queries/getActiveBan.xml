<?xml version="1.0" encoding="UTF-8"?>
<query id="getActiveBan" action="select">
    <tables>
        <table name="blockman_ban_records" alias="b" />
    </tables>
    <columns>
        <column name="b.*" />
    </columns>
    <conditions>
        <condition operation="equal" column="b.member_srl" var="member_srl" notnull="notnull" />
        <condition operation="equal" column="b.status" var="status" default="active" />
        <condition operation="in" column="b.ban_type" var="ban_type" default="temporary,permanent" />
    </conditions>
    <navigation>
        <index default="b.start_date" order="order_type" orderdefault="desc" />
        <list_count default="1" />
        <page default="1" />
    </navigation>
</query>
